//Imports
import java.awt.BorderLayout;
import java.sql.*;
import javax.swing.*;
import javax.swing.table.DefaultTableModel;

public class DisplayStudentInfo {
    //DISPLAY STUDENTS INFO BUTTON:
    private final JTable studentTable;  // Holds data in a tabular format
    private final JScrollPane jScrollPane1;  // I used Scrollpane to show info
    private final JButton jButton2;  // Button to display student info

    // Constructor to initialize the JFrame and components
    public DisplayStudentInfo() {
        //table initialization + button n scroll pane
        studentTable = new JTable();
        jScrollPane1 = new JScrollPane(studentTable);
        jButton2 = new JButton("Display Student Info");

        // Add ActionListener to the button
        jButton2.addActionListener(evt -> jButton2ActionPerformed(evt));

        // Frame layout code
        JFrame frame = new JFrame("Display Student Info");
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLayout(new BorderLayout());
        frame.add(jScrollPane1, BorderLayout.CENTER);
        frame.add(jButton2, BorderLayout.SOUTH);
        frame.setSize(600, 400);
        frame.setVisible(true);
    }

    // Method to handle button click and display student info from the database
    private void jButton2ActionPerformed(java.awt.event.ActionEvent evt) {
        // Database connection part
        String jdbcUrl = "jdbc:mysql://localhost:3306/school";  // Adjust your database URL
        String username = "root";
        String password = "";  //Password is empty [not set]

        // SQL query to fetch data from the 'students' table---------
        String query = "SELECT Full_Name, Department, Level, Reg_Number FROM students";

        // Usig try
        try (Connection connection = DriverManager.getConnection(jdbcUrl, username, password);
             Statement statement = connection.createStatement();
             ResultSet resultSet = statement.executeQuery(query)) {

            // Prepare the table model with column names//
            DefaultTableModel tableModel = new DefaultTableModel();
            tableModel.addColumn("Full Name");
            tableModel.addColumn("Department");
            tableModel.addColumn("Level");
            tableModel.addColumn("Registration Number");

            // Populate the table model with data from the result
            while (resultSet.next()) {
                String fullName = resultSet.getString("Full_Name");
                String department = resultSet.getString("Department");
                int level = resultSet.getInt("Level");
                String regNumber = resultSet.getString("Reg_Number");
                tableModel.addRow(new Object[]{fullName, department, level, regNumber});
            }

            // Set the table model to the JTable
            studentTable.setModel(tableModel);

        } catch (SQLException e) {
            // Show an error message if the database query fails
            JOptionPane.showMessageDialog(null, "Error fetching data: " + e.getMessage());
            
        }
    }

    // Main method to run the DisplayStudentInfo application
    public static void main(String[] args) {
        javax.swing.SwingUtilities.invokeLater(DisplayStudentInfo::new);  // Initilize app and run it
    }
}
