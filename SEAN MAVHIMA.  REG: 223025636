        double loanAmount = Double.parseDouble(loanAmountString);

        // Calculate monthly payment (Formula for monthly payment on a loan)
        double monthlyPayment = (loanAmount * monthlyInterestRate) /
                (1 - Math.pow(1 + monthlyInterestRate, -numberOfYears * 12));

        // Calculate total payment over the life of the loan
        double totalPayment = monthlyPayment * numberOfYears * 12;

        // Display monthly payment
        JOptionPane.showMessageDialog(null, "Your monthly payment is: " + String.format("%.2f", monthlyPayment));

